# 3D Cinema Platform - Environment Configuration Example

# Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_password
POSTGRES_DB=cinema_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cinema_user:cinema_password@localhost:5432/cinema_platform
DATABASE_SYNC_URL=postgresql://cinema_user:cinema_password@localhost:5432/cinema_platform

# Redis (Coordination & PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Seat Lock Settings
SEAT_LOCK_EXPIRATION_SECONDS=600

# Object Storage (S3 / MinIO for GLB assets & posters)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ASSETS=cinema-3d-assets
S3_REGION=us-east-1

# Payment Gateway (Mock / Sandbox)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_key
